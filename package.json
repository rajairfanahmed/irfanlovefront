    "type": "git",
    "url": "git+https://github.com/rajairfanahmed/irfanlovefront.git"
  },
  "bugs": {
    "url": "https://github.com/rajairfanahmed/irfanlovefront/issues"
  },
  "homepage": "https://rajairfanahmed.github.io/irfanlovefront",
