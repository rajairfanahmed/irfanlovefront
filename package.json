{
  "name": "irfanlovefront",
  "version": "3.2.6",
  "description": "Master Frontend Engineering Suite, MCP Server & One-Command Installer for irfanlovefront UI/UX agent skills across Claude Code, Antigravity, Cursor, Windsurf, and Copilot",
  "type": "module",
  "bin": {
    "irfanlovefront": "bin/cli.js",
    "irfanlovefront-mcp": "bin/mcp.js"
  },
  "scripts": {
    "build:mcp": "npm --prefix mcp run build",
    "extract": "node bin/cli.js extract",
    "awwwards": "node bin/cli.js awwwards",
    "mcp": "node bin/mcp.js",
    "start": "node bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "mcp/dist",
    "mcp/package.json",
    ".agents",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai-agents",
    "skills",
    "claude-code",
    "antigravity",
    "cursor",
    "cursor-rules",
    "windsurf",
    "github-copilot",
    "frontend-engineering",
    "design-system",
    "ui-ux"
  ],
